{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leadown",
  "version": "0.1.1",
  "identifier": "com.fireflylabss.leadown",
  "build": {
    "frontendDist": "frontend",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "echo 'ready'",
    "beforeBuildCommand": "echo 'ready'"
  },
  "app": {
    "windows": [
      {
        "title": "Leadown",
        "width": 1200,
        "height": 800,
        "minWidth": 560,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "assets/leadown.icns",
      "assets/leadown.ico"
    ]
  }
}
