# Maintainer: fireflylabs
pkgname=leadown
pkgver=0.1.1
pkgrel=1
pkgdesc="Minimal local-first markdown notes editor"
arch=('x86_64' 'aarch64')
url="https://github.com/fireflylabss/leadown"
license=('Apache-2.0' 'OFL-1.1')
depends=(
	'libxkbcommon'
	'libxkbcommon-x11'
	'libxcb'
	'xcb-util-wm'
	'xcb-util-image'
	'xcb-util-keysyms'
	'xcb-util-renderutil'
	'wayland'
	'fontconfig'
	'alsa-lib'
	'gcc-libs'
	'glibc'
)
makedepends=('rust' 'pkgconf')
provides=('leadown')
conflicts=('leadown-bin')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::https://github.com/fireflylabss/leadown/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
	cd "leadown-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	cargo fetch --locked
}

build() {
	cd "leadown-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	cargo build --release --frozen
}

check() {
	cd "leadown-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	cargo test --frozen
}

package() {
	cd "leadown-$pkgver"
	install -Dm755 target/release/leadown "$pkgdir/usr/bin/leadown"
	install -Dm644 assets/leadown.desktop "$pkgdir/usr/share/applications/leadown.desktop"
	install -Dm644 assets/leadown.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/leadown.png"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 assets/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
